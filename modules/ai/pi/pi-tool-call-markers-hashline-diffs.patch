+const HASHLINE_EDIT_TOOLS = new Set(["replace", "replace_match", "insert", "move", "copy"]);
+
+function hashlineEditLabel(row: ToolExecutionRow): string | undefined {
+  if (!HASHLINE_EDIT_TOOLS.has(row.toolName ?? "")) return undefined;
+  const path = (row.args as { path?: unknown } | undefined)?.path;
+  return typeof path === "string" ? `${row.toolName} ${path}` : row.toolName;
+}
+
+function hashlineDiffPreview(row: ToolExecutionRow, theme: ThemeLike): string | undefined {
+  if (
+    !HASHLINE_EDIT_TOOLS.has(row.toolName ?? "") ||
+    !row.result ||
+    row.isPartial !== false ||
+    rowHasFailed(row)
+  ) return undefined;
+  const diff = row.result.details?.diff;
+  if (typeof diff !== "string") return undefined;
+  const changed = diff
+    .split("\n")
+    .filter(
+      (line) =>
+        /^(?:\+|-)(?!\+\+|-{2})\S/.test(line) ||
+        /^\d+\s*│ (?:-[\w]{4}| [\w]{4})│/.test(line),
+    );
+  if (changed.length === 0) return undefined;
+  const preview = changed.slice(0, 2).map((line) => {
+    const plain = sanitizeInline(stripAnsi(line));
+    return plain.length > 48 ? `${plain.slice(0, 47)}…` : plain;
+  });
+  if (changed.length > preview.length) {
+    preview.push(`… +${changed.length - preview.length} lines`);
+  }
+  return fgCollapsed(theme, "toolOutput", preview.join("  "));
+}
