From df3d2cd5167e1b15202e019c90350ea0039107e2 Mon Sep 17 00:00:00 2001
From: Disturbed Ocean <241662633+DisturbedOcean@users.noreply.github.com>
Date: Sun, 8 Nov 2026 15:53:50 -0800
Subject: [PATCH] fix(pi-compat): let Pi extensions call their own provider
 outside tool calls

- modelRegistry.streamSimple runs an extension-owned provider's own stream
  (with a plain JSON context) instead of host nested inference, which only
  admits model-tool parents.
- nested inference accepts sessionId, a prompt-cache hint.
- convertToLlm passes system/user/assistant/toolResult messages through
  without reading timestamps they may not carry, as Pi does.
---
 lib/model-registry-stream.mjs       |  3 ++-
 lib/providers.mjs                   |  9 ++++++++-
 lib/public-helpers.mjs              |  3 ++-
 test/provider-registration.test.mjs | 10 ++++++++++
 test/public-helpers.test.mjs        |  7 +++++++
 5 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/lib/model-registry-stream.mjs b/lib/model-registry-stream.mjs
index d848f938..1b3ded3b 100644
--- a/lib/model-registry-stream.mjs
+++ b/lib/model-registry-stream.mjs
@@ -68,7 +68,8 @@ function identity(value) {
 function request(context, options) {
   fields(context, ['messages', 'systemPrompt', 'tools'], 'nested inference context');
   if (context.tools !== undefined && (!Array.isArray(context.tools) || context.tools.length)) unsupported('nested inference tools', 'nested inference cannot grant tool execution');
-  fields(options, ['signal', 'maxTokens', 'temperature', 'reasoning'], 'nested inference options');
+  // sessionId only steers provider prompt-cache affinity; the host request carries none, so dropping it costs at most a cache hit.
+  fields(options, ['signal', 'maxTokens', 'temperature', 'reasoning', 'sessionId'], 'nested inference options');
   if (options.signal !== undefined && !(options.signal instanceof AbortSignal)) invalid('nested inference signal');
   if (options.reasoning !== undefined && !efforts.has(options.reasoning)) invalid('nested inference reasoning');
   if (options.maxTokens !== undefined && (!Number.isSafeInteger(options.maxTokens) || options.maxTokens <= 0)) invalid('nested inference token limit');
diff --git a/lib/providers.mjs b/lib/providers.mjs
index 88b969cf..816b6fa7 100644
--- a/lib/providers.mjs
+++ b/lib/providers.mjs
@@ -97,7 +97,14 @@ export function modelRegistry(getHost, runtime = {}) {
     }),
     getAll: () => all(),
     find: (provider, id) => all().find(model => model.provider === provider && model.id === id),
-    streamSimple: (model, context, options) => streamRegistryModel(runtime, model, context, options),
+    streamSimple: (model, context, options) => {
+      // An extension-owned provider streams with its own endpoint and key, as under Pi; host nested inference only admits model-tool parents.
+      const entry = providers(runtime).committed.get(model?.provider);
+      const own = entry && !entry.inherited && !entry.custom && entry.models?.find(candidate => candidate.pi.id === model.id);
+      if (!own) return streamRegistryModel(runtime, model, context, options);
+      // The JSON copy drops strict proxies: Pi's own provider code reads absent message fields as undefined.
+      return withNativeProvider(runtime, { entry }, () => entry.stream(structuredClone(own.pi), JSON.parse(JSON.stringify(context)), options));
+    },
     // Pi: whether the model's provider authenticates with a subscription login.
     // The host states it, from the provider's own authentication resolver, for
     // every model it describes. A model it did not describe, or one whose
diff --git a/lib/public-helpers.mjs b/lib/public-helpers.mjs
index 4c99921c..3a182347 100644
--- a/lib/public-helpers.mjs
+++ b/lib/public-helpers.mjs
@@ -125,13 +125,14 @@ function bashExecutionToText(message) {
 }
 export function convertToLlm(messages) {
   return messages.flatMap(message => {
+    // Pi returns these unchanged, so their timestamps (absent on a system message) are never read.
+    if (['system', 'user', 'assistant', 'toolResult'].includes(message.role)) return [message];
     const { timestamp } = message;
     switch (message.role) {
       case 'bashExecution': return message.excludeFromContext ? [] : [{ role: 'user', content: [{ type: 'text', text: bashExecutionToText(message) }], timestamp }];
       case 'custom': return [{ role: 'user', content: typeof message.content === 'string' ? [{ type: 'text', text: message.content }] : message.content, timestamp }];
       case 'branchSummary': return [{ role: 'user', content: [{ type: 'text', text: `The following is a summary of a branch that this conversation came back from:\n\n<summary>\n${message.summary}</summary>` }], timestamp }];
       case 'compactionSummary': return [{ role: 'user', content: [{ type: 'text', text: `The conversation history before this point was compacted into the following summary:\n\n<summary>\n${message.summary}\n</summary>` }], timestamp }];
-      case 'system': case 'user': case 'assistant': case 'toolResult': return [message];
       default: return [];
     }
   });
diff --git a/test/provider-registration.test.mjs b/test/provider-registration.test.mjs
index 77d971ca..aadfd9b0 100644
--- a/test/provider-registration.test.mjs
+++ b/test/provider-registration.test.mjs
@@ -300,6 +300,16 @@ test('modelRegistry lists registered provider ids and returns their configs', as
   assert.deepEqual(registry.getRegisteredProviderIds(), []);
 });
 
+test('modelRegistry.streamSimple runs an extension-owned provider stream with a plain context', async () => {
+  let call;
+  const value = await registered((model, context, options) => { call = { model, context, options }; return 'stream'; });
+  const registry = modelRegistry(() => ({}), value.runtime);
+  const strictSystem = new Proxy({ role: 'system', content: 'prompt' }, { get(target, key) { if (key === 'timestamp') throw new Error('unsupported'); return Reflect.get(target, key); } });
+  assert.equal(registry.streamSimple({ provider: 'pi-local-provider', id: 'virtual/model' }, { messages: [strictSystem] }, { sessionId: 's' }), 'stream');
+  assert.equal(call.model.id, 'virtual/model');
+  assert.deepEqual(call.context, { messages: [{ role: 'system', content: 'prompt' }] });
+  assert.deepEqual(call.options, { sessionId: 's' });
+});
 
 test('model provider is rebased and per-model baseUrl overrides provider endpoint', async () => {
   let selected;
diff --git a/test/public-helpers.test.mjs b/test/public-helpers.test.mjs
index 3f5fe60f..cc186ac8 100644
--- a/test/public-helpers.test.mjs
+++ b/test/public-helpers.test.mjs
@@ -72,6 +72,13 @@ test('message conversion excludes private details and preserves original LLM mes
   ]).startsWith('[Assistant thinking]: plan\n\n[Assistant]: answer\n\n[Assistant tool calls]: read(path="a")'), true);
 });
 
+test('message conversion passes a timestamp-less system message through, as Pi does', () => {
+  const system = new Proxy({ role: 'system', content: 'prompt' }, {
+    get(target, key) { if (key === 'timestamp') throw new Error('unsupported_feature system message.timestamp'); return Reflect.get(target, key); },
+  });
+  assert.equal(helpers.convertToLlm([system])[0], system);
+});
+
 test('file mutation queue serializes aliases, releases on failure and permits other files', async t => {
   const dir = await mkdtemp(join(tmpdir(), 'octet-pi-helpers-'));
   t.after(() => rm(dir, { recursive: true, force: true }));
